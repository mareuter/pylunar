{
    "enabled": true,
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
      "config:best-practices",
      ":rebaseStalePrs"
    ],
    "lockFileMaintenance": {
      "enabled": true
    },
    "packageRules": [
      {
        "description": "Automerge non-major updates",
        "matchUpdateTypes": [
          "minor",
          "patch"
        ],
        "automerge": true
      },
      {
        "matchManagers": ["pyenv"],
        "enabled": false
      }
    ],
    "timezone": "America/Phoenix",
    "schedule": ["* * 12,24 * *"]
}